# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging / build output
build/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
share/python-wheels/
*.egg-info/
*.egg
MANIFEST
pip-wheel-metadata/

# NOTE: `dist/` is where PyInstaller writes the .app / .exe as well.
dist/

# ---------------------------------------------------------------------------
# PyInstaller
# ---------------------------------------------------------------------------
# packaging/retrocam.spec is checked in on purpose (it is the build contract).
# Anything PyInstaller generates next to it is not.
*.manifest
*.pyinstaller
/packaging/build/
/packaging/dist/
# Spec files auto-generated by a bare `pyinstaller script.py` invocation.
/*.spec

# Release artifacts. `ditto` and the Windows `ren` step write these into the
# repo root, and they are tens of megabytes each. CI attaches them to the
# GitHub release; they must never be committed.
/RetroCam-Rescue-*.zip
/RetroCam-Rescue-*.exe
/RetroCam-Rescue-*.tar.gz
/SHA256SUMS.txt

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.env
.python-version
uv.lock

# ---------------------------------------------------------------------------
# Testing / coverage / type checking
# ---------------------------------------------------------------------------
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.dmypy.json
.ruff_cache/
.hypothesis/

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ---------------------------------------------------------------------------
# Windows
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.claude/

# ---------------------------------------------------------------------------
# RetroCam Rescue runtime output
# ---------------------------------------------------------------------------
# The GUI writes its log next to the download folder; never commit one, it
# contains local paths and file names from someone's photo card.
RetroCam_Rescue.log
*.log
